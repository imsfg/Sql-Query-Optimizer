# ---- LLM provider: set ONE key below ----
# Claude (Anthropic): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Gemini (Google): free tier available at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# anthropic | gemini. If unset: anthropic when ANTHROPIC_API_KEY is set, otherwise gemini.
# LLM_PROVIDER=gemini
# Defaults: claude-opus-5 (anthropic), gemini-3.8-flash (gemini)
# LLM_MODEL=

# Anthropic only: server-side refusal fallback (beta). Set to false if a gateway rejects beta params.
LLM_REFUSAL_FALLBACK=true
LLM_TIMEOUT_S=90

# ---- Agent / database ----
MAX_SQL_ATTEMPTS=3
MAX_RESULT_ROWS=200
MAX_EXPORT_ROWS=10000
QUERY_TIMEOUT_S=5
MAX_INPUT_CHARS=4000
HISTORY_TURNS=8
FULL_SCHEMA_TABLE_LIMIT=15
# DB_PATH=data/company.db
# CHECKPOINT_DB_PATH=data/checkpoints.db
